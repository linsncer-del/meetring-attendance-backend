# ============================================================
# KMTAMS Backend — Environment Variables Template
# ============================================================
# Commit this file. DO NOT commit .env (add it to .gitignore).
# ============================================================

# ── Supabase ─────────────────────────────────────────────────
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── App ───────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
APP_BASE_URL=http://localhost:3000

# ── Email — SMTP / Resend ──────────────────────────────────────
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=resend
SMTP_PASS=your-resend-api-key
SMTP_FROM_EMAIL=no-reply@getkeja.online
SMTP_FROM_NAME=Getkeja

RESEND_API_KEY=your-resend-api-key
SMTP_FROM="Getkeja <no-reply@getkeja.online>"

